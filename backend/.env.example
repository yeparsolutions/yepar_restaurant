# ============================================================
# YEPAR RESTAURANT — backend/.env.example
# Variables de entorno del backend. En Railway se cargan en Variables del servicio;
# en tu computador puedes copiarlas a un archivo .env (NUNCA lo subas a GitHub).
# ============================================================

# Base de datos. En Railway: referencia a la de PostgreSQL → ${{Postgres.DATABASE_URL}}
# Sin esta variable se usa un SQLite local (solo para desarrollo).
DATABASE_URL=postgresql://usuario:clave@host:5432/railway

# Clave que firma las sesiones y cifra las API Key de los facturadores. OBLIGATORIA con PostgreSQL.
# Genérala con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si la cambias: todos deben volver a iniciar sesión y hay que reconectar los facturadores.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Dominios desde los que se permite usar la API (la web/tablet), separados por coma.
CORS_ORIGINS=https://restaurant.tudominio.com

# Opcionales (valores por defecto entre paréntesis)
ACCESS_TOKEN_MINUTES=720          # duración de la sesión: 720 = un turno de 12 horas
ALGORITHM=HS256
BCRYPT_ROUNDS=12                  # más alto = contraseñas más lentas de adivinar (y de verificar)

# Facturadores (solo si usas otra dirección que la oficial)
YEPARDTE_API_URL=https://api.yepardte.cl
YEPARFACTURA_API_URL=https://yeparfactura.yeparsolution.com
YEPARFACTURA_ALICUOTA=16          # IVA de Venezuela, en %

# Solo para el script crear_restaurante.py en modo automático (mejor dejar que la pida por teclado)
# YEPAR_ADMIN_PASSWORD=
